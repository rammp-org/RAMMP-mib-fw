# Default target for the RAMMP MIB firmware
CONFIG_IDF_TARGET="esp32p4"
# CONFIG_IDF_TARGET="esp32"
# CONFIG_IDF_TARGET="esp32s2"
# CONFIG_IDF_TARGET="esp32s3"
# CONFIG_IDF_TARGET="esp32c3"

# TODO: uncomment if you want freertos to run at 1 khz instead of the default 100 hz
# CONFIG_FREERTOS_HZ=1000

# TODO: uncomment if you want to run the esp at max clock speed (240 mhz)
# ESP32-specific
#
# CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# TODO: uncomment if you want to update the event and main task stask sizes
# Common ESP-related
#
# CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
# CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# FreeRTOS configuration 
CONFIG_FREERTOS_HZ=1000

# LVGL compatibility settings for ESP-IDF 6 warning-as-error builds.
CONFIG_LV_MEM_SIZE=65536
CONFIG_LV_MEM_SIZE_KILOBYTES=0
CONFIG_LV_DISABLE_ASSERT_HANDLER_INCLUDE_WARNING=y

# Control panel service link (components/ServiceLink). TinyUSB serves one WebUSB
# vendor interface on the P4's USB 2.0 HS port (J3 on the ESP32-P4-ETH). The USB-C
# is a CH343 UART bridge and keeps the console and flashing.
CONFIG_TINYUSB_VENDOR_COUNT=1
CONFIG_TINYUSB_VENDOR_RX_BUFSIZE=4096
CONFIG_TINYUSB_VENDOR_TX_BUFSIZE=8192

# RTPS endpoint pool (espp/rtps). Writers: a command and a tuning per motor board, status,
# Diagnostics, Motors, estop-core's, SPDP. Readers: a state per motor board, the joystick's
# four inputs, estop-core's, SPDP. Per participant adds SEDP's two of each. mib_system.cpp
# checks these against the axis table.
CONFIG_RTPS_LIMIT_NUM_STATELESS_WRITERS=14
CONFIG_RTPS_LIMIT_NUM_STATELESS_READERS=12
CONFIG_RTPS_LIMIT_NUM_WRITERS_PER_PARTICIPANT=20
CONFIG_RTPS_LIMIT_NUM_READERS_PER_PARTICIPANT=20
CONFIG_RTPS_LIMIT_MAX_NUM_READER_CALLBACKS=14
# SEDP keeps one sample per endpoint in a stateful history, and the esp32 profile's depth
# is 10: with 12 writers the first two announcements (estop-core's EStop, MibStatus) fell
# out, so a participant that joined after the MIB never saw them. Match the per-participant
# endpoint limit above.
CONFIG_RTPS_LIMIT_HISTORY_SIZE_STATEFUL=20
# Remote endpoints one endpoint can match. The two SEDP writers hold one reader proxy per
# remote participant and the two SEDP readers one writer proxy each, so the esp32 profile's
# 6 completes discovery with six participants and silently skips the rest; a ROS 2 host
# runs more than that. Remote participants themselves are capped at 10 by espp/rtps
# 1.3.11 (SPDP_MAX_NUMBER_FOUND_PARTICIPANTS, no knob yet: esp-cpp/espp#870), and a
# CycloneDDS peer expires after 10 s until esp-cpp/espp#871 lands.
CONFIG_RTPS_LIMIT_NUM_READER_PROXIES_PER_WRITER=24
CONFIG_RTPS_LIMIT_NUM_WRITER_PROXIES_PER_READER=24

# Firmware updates over the service link (Ethernet, UART or WebUSB): two 3 MB OTA slots
# (partitions.csv) and bootloader rollback. The ESP32-P4-ETH has 32 MB of flash; 16 MB is
# declared, which is all the table needs. Moving to this table takes one USB flash
# (idf.py flash: bootloader, partition table and app); updates go over the panel after that.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# The panel's TCP service port (a listener and one client) beside the RTPS sockets;
# the PACE RACER raised the same limit for its EthLink.
CONFIG_LWIP_MAX_SOCKETS=16
